/* Countdown shorter than one minute. */
"format.lessThanMinute" = "<1m";

/* Countdown in days and hours, for example 1d 3h; the arguments are whole numbers. */
"format.countdown.dayHour" = "%1$lldd %2$lldh";

/* Countdown in whole days, for example 2d; the argument is a whole number. */
"format.countdown.day" = "%lldd";

/* Countdown in hours and minutes, for example 2h 14m; the arguments are whole numbers. */
"format.countdown.hourMinute" = "%1$lldh %2$lldm";

/* Countdown in whole hours, for example 2h; the argument is a whole number. */
"format.countdown.hour" = "%lldh";

/* Countdown in minutes, for example 45m; the argument is a whole number. */
"format.countdown.minute" = "%lldm";

/* Spoken countdown shorter than one minute (for VoiceOver). */
"format.spokenLessThanMinute" = "less than a minute";

/* Age of a snapshot under one minute. */
"format.justNow" = "just now";

/* Age of a snapshot in minutes; the argument is a whole number. */
"format.minutesAgo" = "%lld min ago";

/* Age of a snapshot in hours; the argument is a whole number. */
"format.hoursAgo" = "%lld h ago";

/* Age of a snapshot in days; the argument is a whole number. */
"format.daysAgo" = "%lld d ago";
