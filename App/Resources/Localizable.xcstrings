{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ left" : {
      "comment" : "VoiceOver: share of the limit still available",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kaldı"
          }
        }
      }
    },
    "%@ of %@" : {
      "comment" : "Extra usage: amount spent of the monthly limit",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ of %2$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ / %2$@"
          }
        }
      }
    },
    "%@ tokens" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ token"
          }
        }
      }
    },
    "%@ tokens, approximate, from Claude Code on this Mac" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ token, yaklaşık, bu Mac’teki Claude Code’dan"
          }
        }
      }
    },
    "%@ used" : {
      "comment" : "VoiceOver: share of a limit already used\nVoiceOver: share of the limit already used",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kullanıldı"
          }
        }
      }
    },
    "%@: %@ tokens" : {
      "comment" : "Tooltip of a bar in the 7-day chart: a date, then a count",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: %2$@ tokens"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: %2$@ token"
          }
        }
      }
    },
    "`/usage` only asks Anthropic for your usage numbers. If Claude Code ever answers it with a model request instead, QuotaRing turns auto-refresh off by itself and tells you." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`/usage` yalnızca Anthropic’ten kullanım değerlerinizi ister. Claude Code bir gün bunun yerine bir model isteğiyle yanıt verirse QuotaRing otomatik yenilemeyi kendiliğinden kapatır ve size bildirir."
          }
        }
      }
    },
    "5-hour session" : {
      "comment" : "VoiceOver: name of the session ring",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5 saatlik oturum"
          }
        }
      }
    },
    "7 days" : {
      "comment" : "Activity range: the last seven days",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 gün"
          }
        }
      }
    },
    "About" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hakkında"
          }
        }
      }
    },
    "About %@ left" : {
      "comment" : "Notification body; the argument is a percentage",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yaklaşık %@ kaldı"
          }
        }
      }
    },
    "About %@ left · resets in %@" : {
      "comment" : "Notification body; a percentage and a duration such as 1h 22m",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "About %1$@ left · resets in %2$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yaklaşık %1$@ kaldı · %2$@ sonra sıfırlanır"
          }
        }
      }
    },
    "About QuotaRing" : {
      "comment" : "Status item menu: show the About panel",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QuotaRing Hakkında"
          }
        }
      }
    },
    "Activity" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkinlik"
          }
        }
      }
    },
    "All models" : {
      "comment" : "Weekly limit that covers every model",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm modeller"
          }
        }
      }
    },
    "Allow Notifications…" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildirimlere İzin Ver…"
          }
        }
      }
    },
    "Anthropic asked QuotaRing to slow down. It tries again in %@." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anthropic, QuotaRing’in daha yavaş çalışmasını istedi. %@ sonra yeniden denenecek."
          }
        }
      }
    },
    "Anthropic's breakdown, all devices" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anthropic’e göre, tüm cihazlar"
          }
        }
      }
    },
    "Approximate, from Claude Code on this Mac" : {
      "comment" : "Caption under the total token count",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yaklaşık, bu Mac’teki Claude Code’dan"
          }
        }
      }
    },
    "Auto-refresh and Live mode get new numbers once the ones shown are this old. Numbers older than twice this are shown as out of date. The Claude Code cache is checked every 30 s." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik yenileme ve Canlı mod, gösterilen değerler bu kadar eskiyince yeni değerler alır. Bunun iki katından eski değerler için “güncel değil” uyarısı gösterilir. Claude Code önbelleği her 30 saniyede bir kontrol edilir."
          }
        }
      }
    },
    "Auto-refresh can run Claude Code's `/usage` for you in the background." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik yenileme, Claude Code’un `/usage` komutunu sizin için arka planda çalıştırabilir."
          }
        }
      }
    },
    "Auto-refresh can't find Claude Code's command-line tool (`claude`). Install it, or choose it in Settings → Data." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik yenileme, Claude Code’un komut satırı aracını (`claude`) bulamıyor. Aracı yükleyin veya Ayarlar → Veri bölümünden seçin."
          }
        }
      }
    },
    "Auto-refresh could not run Claude Code. QuotaRing tries again later." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik yenileme Claude Code’u çalıştıramadı. QuotaRing daha sonra yeniden dener."
          }
        }
      }
    },
    "Auto-refresh is off. QuotaRing does not run Claude Code." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik yenileme kapalı. QuotaRing, Claude Code’u çalıştırmaz."
          }
        }
      }
    },
    "Auto-refresh is on. The first reading should arrive in a moment." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik yenileme açık. İlk veriler birazdan gelmeli."
          }
        }
      }
    },
    "Auto-refresh is on. Turning it off stops it right away." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik yenileme açık. Kapatırsanız hemen durur."
          }
        }
      }
    },
    "Auto-refresh is running Claude Code…" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik yenileme Claude Code’u çalıştırıyor…"
          }
        }
      }
    },
    "Auto-refresh last ran %@." : {
      "comment" : "Auto-refresh status; the argument is a relative time such as 3 min ago",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik yenileme en son %@ çalıştı."
          }
        }
      }
    },
    "Auto-refresh turned itself off: Claude Code answered `/usage` with a model request, which would use your limits." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik yenileme kendini kapattı: Claude Code, `/usage` komutunu bir model isteğiyle yanıtladı; bu, limitlerinizi tüketirdi."
          }
        }
      }
    },
    "Auto-refresh turned itself off: QuotaRing couldn't confirm that Claude Code's last runs were free, because their answers were not in the expected format." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik yenileme kendini kapattı: Claude Code’un son çalıştırmalarının yanıtları beklenen biçimde olmadığı için QuotaRing bunların ücretsiz olduğunu doğrulayamadı."
          }
        }
      }
    },
    "Auto-refresh: Claude Code could not be started. QuotaRing tries again later." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik yenileme: Claude Code başlatılamadı. QuotaRing daha sonra yeniden dener."
          }
        }
      }
    },
    "Auto-refresh: Claude Code is not signed in. Run `claude` once in Terminal and sign in." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik yenileme: Claude Code’da oturum açılmamış. Terminal’de `claude` komutunu bir kez çalıştırıp giriş yapın."
          }
        }
      }
    },
    "Auto-refresh: Claude Code printed far more than expected and was stopped. QuotaRing tries again later." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik yenileme: Claude Code beklenenden çok daha fazla çıktı verdiği için durduruldu. QuotaRing daha sonra yeniden dener."
          }
        }
      }
    },
    "Auto-refresh: Claude Code ran, but its usage numbers did not change. QuotaRing tries again later." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik yenileme: Claude Code çalıştı ama kullanım değerleri değişmedi. QuotaRing daha sonra yeniden dener."
          }
        }
      }
    },
    "Auto-refresh: Claude Code ran, but QuotaRing couldn't read its usage numbers afterwards. QuotaRing tries again later." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik yenileme: Claude Code çalıştı ama QuotaRing ardından kullanım değerlerini okuyamadı. QuotaRing daha sonra yeniden dener."
          }
        }
      }
    },
    "Auto-refresh: Claude Code reported an error. QuotaRing tries again later." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik yenileme: Claude Code bir hata bildirdi. QuotaRing daha sonra yeniden dener."
          }
        }
      }
    },
    "Auto-refresh: Claude Code took too long and was stopped. QuotaRing tries again later." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik yenileme: Claude Code çok uzun sürdüğü için durduruldu. QuotaRing daha sonra yeniden dener."
          }
        }
      }
    },
    "Auto-refresh: Claude Code's answer was not in the expected format. QuotaRing tries again later." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik yenileme: Claude Code’un yanıtı beklenen biçimde değildi. QuotaRing daha sonra yeniden dener."
          }
        }
      }
    },
    "Auto-refresh: Claude Code's file changed while it was being checked, so it was not run. QuotaRing tries again later." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik yenileme: Claude Code’un dosyası kontrol edilirken değiştiği için çalıştırılmadı. QuotaRing daha sonra yeniden dener."
          }
        }
      }
    },
    "By default, QuotaRing works entirely on this Mac:" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsayılan olarak QuotaRing tamamen bu Mac’te çalışır:"
          }
        }
      }
    },
    "Can't read Claude Code's usage cache (its contents are not in the expected format)" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code’un kullanım önbelleği okunamıyor (içeriği beklenen biçimde değil)"
          }
        }
      }
    },
    "Can't read Claude Code's usage cache (the file can't be opened)" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code’un kullanım önbelleği okunamıyor (dosya açılamıyor)"
          }
        }
      }
    },
    "Can't read Claude Code's usage cache (the file is larger than 50 MB)" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code’un kullanım önbelleği okunamıyor (dosya 50 MB’tan büyük)"
          }
        }
      }
    },
    "Cancel" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vazgeç"
          }
        }
      }
    },
    "Choose" : {
      "comment" : "Folder picker confirm button",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seç"
          }
        }
      }
    },
    "Choose Claude Code's command-line tool, claude. It is often in ~/.local/bin, ~/.npm-global/bin, /opt/homebrew/bin or /usr/local/bin." : {
      "comment" : "File picker message for Claude Code's command-line tool",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code’un komut satırı aracını (claude) seçin. Genellikle ~/.local/bin, ~/.npm-global/bin, /opt/homebrew/bin veya /usr/local/bin klasöründedir."
          }
        }
      }
    },
    "Choose the folder Claude Code keeps its data in. The default is ~/.claude." : {
      "comment" : "Folder picker message",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code’un verilerini sakladığı klasörü seçin. Varsayılan: ~/.claude"
          }
        }
      }
    },
    "Choose…" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seç…"
          }
        }
      }
    },
    "Claude app (%@)" : {
      "comment" : "The Claude Code build bundled with the Claude desktop app; the argument is its version",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude uygulaması (%@)"
          }
        }
      }
    },
    "Claude Code" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code"
          }
        }
      }
    },
    "Claude Code · %@" : {
      "comment" : "Popover footer: data came from Claude Code's own cache; the argument is like 3 min ago",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code · %@"
          }
        }
      }
    },
    "Claude Code %@" : {
      "comment" : "The found command-line tool's version; the argument is a version number such as 2.1.287",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code %@"
          }
        }
      }
    },
    "Claude Code %@ at %@ is too old for auto-refresh — update it or choose another." : {
      "comment" : "Auto-refresh status; the arguments are a version such as 1.0.113 and a path such as /usr/local/bin/claude",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code %1$@ at %2$@ is too old for auto-refresh — update it or choose another."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ konumundaki Claude Code %1$@, otomatik yenileme için çok eski — güncelleyin veya başka birini seçin."
          }
        }
      }
    },
    "Claude Code %@, too old for auto-refresh" : {
      "comment" : "The found command-line tool's version; the argument is a version number such as 1.0.113",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code %@, otomatik yenileme için çok eski"
          }
        }
      }
    },
    "Claude Code at %@ is too old for auto-refresh — update it or choose another." : {
      "comment" : "Auto-refresh status; the argument is a path such as /usr/local/bin/claude",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ konumundaki Claude Code, otomatik yenileme için çok eski — güncelleyin veya başka birini seçin."
          }
        }
      }
    },
    "Claude Code uses and renews its own login. QuotaRing never reads, sees or stores your credentials." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code kendi girişini kullanır ve yeniler. QuotaRing kimlik bilgilerinizi asla okumaz, görmez veya saklamaz."
          }
        }
      }
    },
    "Claude Code uses its own login; QuotaRing never sees your credentials. No AI request, no usage spent, no session saved." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code kendi girişini kullanır; QuotaRing kimlik bilgilerinizi asla görmez. Yapay zekâ isteği yapılmaz, kullanım harcanmaz, oturum kaydedilmez."
          }
        }
      }
    },
    "Claude Code, too old for auto-refresh" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code, otomatik yenileme için çok eski"
          }
        }
      }
    },
    "Claude Code's login (an access token) from your macOS Keychain, or from Claude Code's own credentials file if there is no Keychain item. Read-only: QuotaRing reads it again on each refresh and never stores it or changes it." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code’un giriş bilgisi (bir erişim token’ı), macOS Anahtar Zinciri’nizden veya Anahtar Zinciri öğesi yoksa Claude Code’un kendi kimlik bilgileri dosyasından okunur. Salt okunurdur: QuotaRing bunu her yenilemede yeniden okur, asla saklamaz veya değiştirmez."
          }
        }
      }
    },
    "Claude Code's login has expired. Run `claude` once to renew it, and usage will appear here." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code girişinin süresi doldu. Yenilemek için `claude` komutunu bir kez çalıştırın; kullanım burada görünecek."
          }
        }
      }
    },
    "Claude Code's own `/usage` command, in the background, exactly like this:" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code’un kendi `/usage` komutu, arka planda, tam olarak şöyle:"
          }
        }
      }
    },
    "Claude config directory" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude yapılandırma klasörü"
          }
        }
      }
    },
    "Claude config directory: %@" : {
      "comment" : "VoiceOver label of the folder path; the argument is a path such as ~/.claude",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude yapılandırma klasörü: %@"
          }
        }
      }
    },
    "Claude session at %@" : {
      "comment" : "Notification title when 5-hour session usage crossed a threshold; the argument is a percentage",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude oturumu: %@ kullanıldı"
          }
        }
      }
    },
    "Click Refresh to ask again, or turn Live mode off." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeniden sormak için Yenile’ye tıklayın veya Canlı modu kapatın."
          }
        }
      }
    },
    "Command-line tool" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komut satırı aracı"
          }
        }
      }
    },
    "Could not turn off launch at login: %@" : {
      "comment" : "Inline error under the Launch at login switch; the argument is the system's reason",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Girişte aç” kapatılamadı: %@"
          }
        }
      }
    },
    "Could not turn on launch at login: %@" : {
      "comment" : "Inline error under the Launch at login switch; the argument is the system's reason",
      "localizations" : {
        "tr" : {
