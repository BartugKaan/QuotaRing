{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ left" : {
      "comment" : "VoiceOver: share of the limit still available",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kaldı"
          }
        }
      }
    },
    "%@ of %@" : {
      "comment" : "Extra usage: amount spent of the monthly limit",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ of %2$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ / %2$@"
          }
        }
      }
    },
    "%@ tokens" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ token"
          }
        }
      }
    },
    "%@ tokens, approximate, from Claude Code on this Mac" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ token, yaklaşık, bu Mac’teki Claude Code’dan"
          }
        }
      }
    },
    "%@ used" : {
      "comment" : "VoiceOver: share of a limit already used\nVoiceOver: share of the limit already used",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kullanıldı"
          }
        }
      }
    },
    "%@: %@ tokens" : {
      "comment" : "Tooltip of a bar in the 7-day chart: a date, then a count",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: %2$@ tokens"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: %2$@ token"
          }
        }
      }
    },
    "5-hour session" : {
      "comment" : "VoiceOver: name of the session ring",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5 saatlik oturum"
          }
        }
      }
    },
    "7 days" : {
      "comment" : "Activity range: the last seven days",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 gün"
          }
        }
      }
    },
    "About" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hakkında"
          }
        }
      }
    },
    "About %@ left" : {
      "comment" : "Notification body; the argument is a percentage",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yaklaşık %@ kaldı"
          }
        }
      }
    },
    "About %@ left · resets in %@" : {
      "comment" : "Notification body; a percentage and a duration such as 1h 22m",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "About %1$@ left · resets in %2$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yaklaşık %1$@ kaldı · %2$@ sonra sıfırlanır"
          }
        }
      }
    },
    "About QuotaRing" : {
      "comment" : "Status item menu: show the About panel",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QuotaRing Hakkında"
          }
        }
      }
    },
    "Activity" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkinlik"
          }
        }
      }
    },
    "All models" : {
      "comment" : "Weekly limit that covers every model",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm modeller"
          }
        }
      }
    },
    "Allow Notifications…" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildirimlere İzin Ver…"
          }
        }
      }
    },
    "Anthropic asked QuotaRing to slow down. It tries again in %@." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anthropic, QuotaRing’in daha yavaş çalışmasını istedi. %@ sonra yeniden denenecek."
          }
        }
      }
    },
    "Anthropic's breakdown, all devices" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anthropic’e göre, tüm cihazlar"
          }
        }
      }
    },
    "Approximate, from Claude Code on this Mac" : {
      "comment" : "Caption under the total token count",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yaklaşık, bu Mac’teki Claude Code’dan"
          }
        }
      }
    },
    "By default, QuotaRing works entirely on this Mac:" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsayılan olarak QuotaRing tamamen bu Mac’te çalışır:"
          }
        }
      }
    },
    "Cancel" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vazgeç"
          }
        }
      }
    },
    "Choose" : {
      "comment" : "Folder picker confirm button",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seç"
          }
        }
      }
    },
    "Choose the folder Claude Code keeps its data in. The default is ~/.claude." : {
      "comment" : "Folder picker message",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code’un verilerini sakladığı klasörü seçin. Varsayılan: ~/.claude"
          }
        }
      }
    },
    "Choose…" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seç…"
          }
        }
      }
    },
    "Claude Code · %@" : {
      "comment" : "Popover footer: data came from Claude Code's own cache; the argument is like 3 min ago",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code · %@"
          }
        }
      }
    },
    "Claude Code's login (an access token) from your macOS Keychain, or from Claude Code's own credentials file if there is no Keychain item. Read-only: QuotaRing reads it again on each refresh and never stores it or changes it." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code’un giriş bilgisi (bir erişim token’ı), macOS Anahtar Zinciri’nizden veya Anahtar Zinciri öğesi yoksa Claude Code’un kendi kimlik bilgileri dosyasından okunur. Salt okunurdur: QuotaRing bunu her yenilemede yeniden okur, asla saklamaz veya değiştirmez."
          }
        }
      }
    },
    "Claude Code's login has expired. Run `claude` once to renew it, and usage will appear here." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code girişinin süresi doldu. Yenilemek için `claude` komutunu bir kez çalıştırın; kullanım burada görünecek."
          }
        }
      }
    },
    "Claude config directory" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude yapılandırma klasörü"
          }
        }
      }
    },
    "Claude config directory: %@" : {
      "comment" : "VoiceOver label of the folder path; the argument is a path such as ~/.claude",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude yapılandırma klasörü: %@"
          }
        }
      }
    },
    "Claude session at %@" : {
      "comment" : "Notification title when 5-hour session usage crossed a threshold; the argument is a percentage",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude oturumu: %@ kullanıldı"
          }
        }
      }
    },
    "Could not turn off launch at login: %@" : {
      "comment" : "Inline error under the Launch at login switch; the argument is the system's reason",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Girişte aç” kapatılamadı: %@"
          }
        }
      }
    },
    "Could not turn on launch at login: %@" : {
      "comment" : "Inline error under the Launch at login switch; the argument is the system's reason",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Girişte aç” açılamadı: %@"
          }
        }
      }
    },
    "Data" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veri"
          }
        }
      }
    },
    "Data is out of date" : {
      "comment" : "VoiceOver: the shown usage is old",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veriler güncel değil"
          }
        }
      }
    },
    "Data is out of date — run `/usage` in Claude Code, or open it, to refresh" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veriler güncel değil — yenilemek için Claude Code’da `/usage` komutunu çalıştırın veya Claude Code’u açın"
          }
        }
      }
    },
    "Day" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gün"
          }
        }
      }
    },
    "Demo data" : {
      "comment" : "Popover footer: the numbers shown are made-up demo data",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demo verisi"
          }
        }
      }
    },
    "Demo mode shows sample data and reads no files." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demo modu örnek veri gösterir ve hiçbir dosyayı okumaz."
          }
        }
      }
    },
    "Demo mode shows sample data: Live mode cannot be changed." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demo modu örnek veri gösterir: Canlı mod değiştirilemez."
          }
        }
      }
    },
    "Each notification appears once per 5-hour session. Everything stays on this Mac." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her bildirim, 5 saatlik oturum başına yalnızca bir kez görünür. Her şey bu Mac’te kalır."
          }
        }
      }
    },
    "Enable Live mode" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canlı modu etkinleştir"
          }
        }
      }
    },
    "Enable Live mode…" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canlı modu etkinleştir…"
          }
        }
      }
    },
    "Extra usage" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ek kullanım"
          }
        }
      }
    },
    "Finish the welcome window first." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önce karşılama penceresini tamamlayın."
          }
        }
      }
    },
    "For up-to-date limits without opening Claude Code, you can turn on Live mode in Settings." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code’u açmadan güncel limitleri görmek için Ayarlar’dan Canlı modu açabilirsiniz."
          }
        }
      }
    },
    "General" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genel"
          }
        }
      }
    },
    "Good to know" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilinmesi gerekenler"
          }
        }
      }
    },
    "It counts tokens from Claude Code's local transcripts. The text of your conversations is not kept." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code’un yerel konuşma kayıtlarındaki token’ları sayar. Konuşmalarınızın metni saklanmaz."
          }
        }
      }
    },
    "It reads the usage numbers Claude Code already saves in its own cache file." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code’un kendi önbellek dosyasına zaten kaydettiği kullanım değerlerini okur."
          }
        }
      }
    },
    "Just refreshed. Live requests are limited to one a minute." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az önce yenilendi. Canlı istekler dakikada bir kez yapılabilir."
          }
        }
      }
    },
    "Keychain prompt" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anahtar Zinciri izni"
          }
        }
      }
    },
    "Last updated %@." : {
      "comment" : "Appended to the menu bar VoiceOver label when the data is old; the argument is like 3 h ago",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son güncelleme: %@."
          }
        }
      }
    },
    "Launch at login" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Girişte aç"
          }
        }
      }
    },
    "left" : {
      "comment" : "Under the percentage in the ring: the share of the limit still available",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "kaldı"
          }
        }
      }
    },
    "Live · %@" : {
      "comment" : "Popover footer: data came from Anthropic's usage endpoint; the argument is like 3 min ago",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canlı · %@"
          }
        }
      }
    },
    "Live mode" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canlı mod"
          }
        }
      }
    },
    "Live mode asks Anthropic for fresh numbers, even when Claude Code has not run for a while." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canlı mod, Claude Code bir süredir çalışmamış olsa bile Anthropic’ten güncel değerler ister."
          }
        }
      }
    },
    "Live mode asks Anthropic for fresher numbers. Here is exactly what happens." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canlı mod, Anthropic’ten daha güncel değerler ister. Neler olduğunu aşağıda ayrıntılı olarak görebilirsiniz."
          }
        }
      }
    },
    "Live mode asks Anthropic for new numbers at most this often. Numbers older than twice this are shown as out of date. The Claude Code cache is checked every 30 s." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canlı mod, Anthropic’ten yeni değerleri en fazla bu sıklıkta ister. Bunun iki katından eski değerler için “güncel değil” uyarısı gösterilir. Claude Code önbelleği her 30 saniyede bir kontrol edilir."
          }
        }
      }
    },
    "Live mode can't reach Anthropic" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canlı mod Anthropic’e ulaşamıyor"
          }
        }
      }
    },
    "Live mode could not reach Anthropic — showing the last known usage" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canlı mod Anthropic’e ulaşamadı — bilinen son kullanım gösteriliyor"
          }
        }
      }
    },
    "Live mode found no Claude Code login — run `claude` once to sign in" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canlı mod Claude Code girişi bulamadı — giriş yapmak için `claude` komutunu bir kez çalıştırın"
          }
        }
      }
    },
    "Live mode is off. Nothing is read from the Keychain and QuotaRing makes no network requests." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canlı mod kapalı. Anahtar Zinciri’nden hiçbir şey okunmaz ve QuotaRing ağ isteği yapmaz."
          }
        }
      }
    },
    "Live mode is on. The first reading should arrive in a moment." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canlı mod açık. İlk veriler birazdan gelmeli."
          }
        }
      }
    },
    "Live mode is on. Turning it off stops all Keychain reads and network requests right away." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canlı mod açık. Kapatırsanız tüm Anahtar Zinciri okumaları ve ağ istekleri hemen durur."
          }
        }
      }
    },
    "Live mode is paused" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canlı mod duraklatıldı"
          }
        }
      }
    },
    "Live mode is rate limited" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canlı mod istek sınırına takıldı"
          }
        }
      }
    },
    "Live mode is rate limited — trying again in %@" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canlı mod istek sınırına takıldı — %@ sonra yeniden denenecek"
          }
        }
      }
    },
    "Live mode needs a Claude Code login. Run `claude` once to sign in, and usage will appear here." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canlı mod için Claude Code girişi gerekiyor. Giriş yapmak için `claude` komutunu bir kez çalıştırın; kullanım burada görünecek."
          }
        }
      }
    },
    "Live mode needs attention." : {
      "comment" : "Appended to the menu bar VoiceOver label when Live mode cannot fetch",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canlı mod dikkat gerektiriyor."
          }
        }
      }
    },
    "Live mode paused: Claude Code login expired — run `claude` once to renew" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canlı mod duraklatıldı: Claude Code girişinin süresi doldu — yenilemek için `claude` komutunu bir kez çalıştırın"
          }
        }
      }
    },
    "macOS has not been asked to allow notifications from QuotaRing yet." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QuotaRing bildirimleri için macOS’ten henüz izin istenmedi."
          }
        }
      }
    },
    "macOS is waiting for your approval. Allow QuotaRing in System Settings → General → Login Items." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS onayınızı bekliyor. QuotaRing’e Sistem Ayarları → Genel → Giriş Öğeleri bölümünden izin verin."
          }
        }
      }
    },
    "macOS may ask to allow Keychain access: choose \"Always Allow\" to avoid repeated prompts." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS, Anahtar Zinciri erişimine izin vermenizi isteyebilir: tekrarlanan istemlerden kaçınmak için “Her Zaman İzin Ver” seçeneğini seçin."
          }
        }
      }
    },
    "macOS may ask whether QuotaRing can use Claude Code's Keychain item. Choose \"Always Allow\" to avoid repeated prompts." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS, QuotaRing’in Claude Code’un Anahtar Zinciri öğesini kullanıp kullanamayacağını sorabilir. Tekrarlanan istemlerden kaçınmak için “Her Zaman İzin Ver” seçeneğini seçin."
          }
        }
      }
    },
    "Menu bar" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menü çubuğu"
          }
        }
      }
    },
    "MIT License" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MIT Lisansı"
          }
        }
      }
    },
    "Models" : {
      "localizations" : {
        "tr" : {
